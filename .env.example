# ---------------------------------------------------------------------------
# MathMastery — environment
# Copy to .env and fill in what you have. Everything below has a safe local
# default; the app runs with no external services.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8787
LOG_LEVEL=info

# Local Postgres. `pnpm db:up` starts a cluster on this port.
DATABASE_URL=postgresql://postgres@127.0.0.1:55432/mathmastery

# Better Auth. Generate a real secret for anything public:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=dev-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=http://localhost:8787
WEB_ORIGIN=http://localhost:5173
SITE_URL=http://localhost:8787
AUTH_PASSWORD_ENABLED=true

# Optional GitHub OAuth. Leave blank to hide the button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI. `fixture` is a deterministic grounded provider that needs no key.
# Set AI_PROVIDER=openai and provide OPENAI_API_KEY to use a real model.
AI_PROVIDER=fixture
OPENAI_API_KEY=
AI_CHAT_MODEL=gpt-4.1-mini
AI_GRADER_MODEL=gpt-4.1-mini
AI_ENABLED=true
AI_DAILY_MESSAGES=40
AI_DAILY_ASSESSMENTS=15

# Optional transactional email (email OTP). In development the OTP is logged
# to the console and exposed at /api/dev/otp for the local UI.
RESEND_API_KEY=
EMAIL_FROM=MathMastery <noreply@mathmastery.local>

# Cron protection for maintenance endpoints.
CRON_SECRET=dev-cron-secret
