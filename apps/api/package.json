{
  "name": "@mm/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/embed-migrations.mjs && tsup && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:parse": "tsx scripts/content/parse.ts",
    "content:ingest": "tsx scripts/content/ingest.ts",
    "content:enrich": "tsx scripts/content/enrich.ts",
    "content:approve": "tsx scripts/content/approve.ts",
    "seed:dev": "tsx src/seed-dev.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.118",
    "@hono/node-server": "^2.1.8",
    "@hono/zod-validator": "^0.9.1",
    "@mm/shared": "workspace:*",
    "ai": "^7.0.173",
    "better-auth": "^1.7.25",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.18",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.0"
  }
}
