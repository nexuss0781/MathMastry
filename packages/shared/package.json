{
  "name": "@mm/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./domain/*": {
      "types": "./src/domain/*.ts",
      "default": "./dist/domain/*.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsup src/index.ts --format esm --clean --sourcemap --external zod --external ts-fsrs"
  },
  "dependencies": {
    "ts-fsrs": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "tsup": "^9.0.0",
    "typescript": "6.0.2",
    "vitest": "^5.1.0"
  }
}
